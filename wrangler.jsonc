{
  "name": "miguel-es",
  "compatibility_date": "2026-03-10",
  "assets": {
    "directory": "./dist",
    // Match Astro's trailingSlash: 'never' (serve /path, redirect /path/ -> /path)
    "html_handling": "drop-trailing-slash",
    // Serve dist/404.html for missing routes instead of an empty response
    "not_found_handling": "404-page"
  }
}
