---
import ResourceEntry from "../../components/ResourceEntry.astro";
import Layout from "../../layouts/Layout.astro";

const courseModules = import.meta.glob('../courses/*.md', { eager: true });
const courses = Object.entries(courseModules).map(([path, mod]) => ({
  frontmatter: mod.frontmatter,
  url: path.replace('..', '/courses').replace('/courses/courses', '/courses').replace('.md', ''),
}));
const courseEntries = courses.map(course => ({
  title: course.frontmatter.title,
  description: course.frontmatter.description,
  url: course.url
}));
---

<Layout title="Miguel González Calvo | Resources" description="Teaching materials, calculators, and curated reference resources on AI, economics, Python, and data science">
  <main class="max-w-3xl mx-auto px-4">
    <h1 class="text-[30px] font-[850] tracking-[-0.03em] mb-6 mt-2">Resources</h1>

    <h2 class="text-[13px] font-extrabold text-accent border-b-2 border-ink pb-[6px] mb-4 mt-8">Teaching</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6 mb-8">
      {courseEntries.map(course => (
        <ResourceEntry
          title={course.title}
          description={course.description}
          url={course.url}
        />
      ))}
      <ResourceEntry
        title="Correcting rubrics"
        description="Rubrics to correct assignments and exams (Spanish)."
        url="/resources/rubrics"
      />
      <ResourceEntry
        title="Teaching materials"
        description="Materials for teaching (Spanish)."
        url="/resources/teaching-materials"
      />
    </div>

    <h2 class="text-[13px] font-extrabold text-accent border-b-2 border-ink pb-[6px] mb-4">Tools & Calculators</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6 mb-8">
      <ResourceEntry
        title="QR Code Generator"
        description="Generate QR codes for URLs, contacts, WiFi, events, and more."
        url="/qr"
      />
      <ResourceEntry
        title="Compound Interest Calculator"
        description="Interactive calculator for compound interest with periodic contributions."
        url="/resources/compound-calculator"
      />
      <ResourceEntry
        title="PPP Calculator"
        description="Convert amounts based on Purchasing Power Parity across countries."
        url="/resources/ppp-calculator"
      />
      <ResourceEntry
        title="Inflation Calculator"
        description="Adjust amounts for inflation using actual OECD CPI data."
        url="/resources/inflation-calculator"
      />
      <ResourceEntry
        title="Average Salary Explorer"
        description="Nominal vs real wage evolution and PPP cross-country comparison with OECD data."
        url="/resources/salary-explorer"
      />
      <ResourceEntry
        title="Loan Amortization Calculator"
        description="Compare French, Italian and American loan amortization methods with schedule and charts (Spanish)."
        url="/resources/loan-calculator"
      />
      <ResourceEntry
        title="Financial mathematics"
        description="Formulas and concepts used in financial mathematics (Spanish)."
        url="/resources/financial-mathematics"
      />
    </div>

    <h2 class="text-[13px] font-extrabold text-accent border-b-2 border-ink pb-[6px] mb-4">Reference Materials</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
      <ResourceEntry
        title="Interesting APIs"
        description="Collection of useful APIs for development and data analysis."
        url="/resources/apis"
      />
      <ResourceEntry
        title="Economic Information Sources"
        description="Reliable sources for economic data and financial information."
        url="/resources/economic-sources"
      />
      <ResourceEntry
        title="Statistical Errors"
        description="Common statistical errors and how to avoid them."
        url="/resources/errors"
      />
      <ResourceEntry
        title="LLM Resources"
        description="Resources for Large Language Models and AI development."
        url="/resources/llm"
      />
      <ResourceEntry
        title="Machine Learning Resources"
        description="Tools, libraries, and guides for machine learning."
        url="/resources/machine-learning"
      />
      <ResourceEntry
        title="Python Resources"
        description="Python libraries, frameworks, and development tools."
        url="/resources/python"
      />
    </div>
  </main>
</Layout>
