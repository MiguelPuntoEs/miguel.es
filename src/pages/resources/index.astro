---
import ResourceEntry from "../../components/ResourceEntry.astro";
import Layout from "../../layouts/Layout.astro";
import { TOOLS } from "../../data/tools.js";
---

<Layout title="Resources" description="Teaching materials, calculators, and curated reference resources on AI, economics, Python, and data science">
  <main class="page">
    <h1 class="page-title" style="margin-bottom:1.5rem">Resources</h1>

    <h2 class="section__title">Teaching materials</h2>
    <div class="rowlist section">
      <ResourceEntry
        title="Courses"
        description="Syllabi, notes and materials for every course I teach."
        url="/courses"
      />
      <ResourceEntry
        title="Correcting rubrics"
        description="Rubrics to correct assignments and exams (Spanish)."
        url="/resources/rubrics"
      />
      <ResourceEntry
        title="Teaching materials"
        description="Materials for teaching (Spanish)."
        url="/resources/teaching-materials"
      />
    </div>

    <h2 class="section__title">Tools & Calculators</h2>
    <div class="rowlist section">
      {
        TOOLS.map((t) => (
          <a class="rowlink" href={t.url}>
            <span class="rowlink__icon">
              <svg class="icon" aria-hidden="true"><use href={`#${t.icon}`} /></svg>
            </span>
            <span class="rowlink__text">
              <span class="rowlink__name">{t.name}</span>
              <span class="rowlink__desc">{t.desc}</span>
            </span>
            <svg class="icon rowlink__go" aria-hidden="true"><use href="#i-arrow-right" /></svg>
          </a>
        ))
      }
    </div>

    <h2 class="section__title">Data</h2>
    <div class="rowlist section">
      <ResourceEntry
        title="Historical monetary data"
        description="Primary-source datasets on the Continental dollar (1777-1781) and the greenbacks (1859-1866), transcribed from the original printed tables."
        url="/data"
      />
    </div>

    <h2 class="section__title">Reference Materials</h2>
    <div class="rowlist">
      <ResourceEntry
        title="Interesting APIs"
        description="Collection of useful APIs for development and data analysis."
        url="/resources/apis"
      />
      <ResourceEntry
        title="Economic Information Sources"
        description="Reliable sources for economic data and financial information."
        url="/resources/economic-sources"
      />
      <ResourceEntry
        title="Statistical Errors"
        description="Common statistical errors and how to avoid them."
        url="/resources/errors"
      />
      <ResourceEntry
        title="LLM Resources"
        description="Resources for Large Language Models and AI development."
        url="/resources/llm"
      />
      <ResourceEntry
        title="Machine Learning Resources"
        description="Tools, libraries, and guides for machine learning."
        url="/resources/machine-learning"
      />
      <ResourceEntry
        title="Python Resources"
        description="Python libraries, frameworks, and development tools."
        url="/resources/python"
      />
    </div>
  </main>
</Layout>
