---
import Layout from "../../../layouts/Layout.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import { PPP_RATES, PPP_VINTAGE } from "../../../data/ppp-rates.js";
import { PPP_PAIRS } from "../../../data/ppp-pairs.js";

export function getStaticPaths() {
  return PPP_PAIRS.map((p) => ({ params: { pair: p.slug }, props: p }));
}

const pair = Astro.props;
const { slug, title, heading, description, context, faqs, currency, country, euroArea } = pair;

const abs = (path) => new URL(path, Astro.site).href;
const canonical = abs(`/resources/ppp-calculator/${slug}`);

const num = (v, digits = 2) =>
  v.toLocaleString("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits });

// Euro-area pairs have no single rate: PPP is measured per country, so the
// page shows the whole set and the spread between its extremes.
const euroCountries = euroArea
  ? Object.entries(PPP_RATES)
      .filter(([, d]) => d.code === "EUR")
      .map(([name, d]) => ({ name, rate: d.rate }))
      .sort((a, b) => a.rate - b.rate)
  : [];
const euroLow = euroCountries[0];
const euroHigh = euroCountries[euroCountries.length - 1];

const rate = country ? PPP_RATES[country].rate : null;
const symbol = country ? PPP_RATES[country].symbol : null;

const others = PPP_PAIRS.filter((p) => p.slug !== slug);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Resources", item: abs("/resources") },
    { "@type": "ListItem", position: 2, name: "PPP Calculator", item: abs("/resources/ppp-calculator") },
    { "@type": "ListItem", position: 3, name: title, item: canonical },
  ],
};
---

<Layout title={`${title} Purchasing Power Parity`} description={description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbLd)}
  />

  <main class="min-h-screen px-3 py-10 sm:px-6">
    <section class="mx-auto max-w-3xl space-y-6">
      <nav class="text-[13px] text-text-3">
        <a href="/resources/ppp-calculator" class="hover:text-text-1">PPP Calculator</a>
        <span> / </span>
        <span>{title}</span>
      </nav>

      <header class="space-y-2">
        <h1 class="text-[22px] font-semibold tracking-[-0.015em] text-text-1">
          {heading}
        </h1>
        <p class="text-sm text-text-2">{description}</p>
      </header>

      {
        !euroArea && (
          <section class="rounded-2xl border border-line bg-bg-1 p-5 shadow-sm">
            <h2 class="mb-3 text-sm font-semibold text-text-1">
              The rate, both directions
            </h2>
            <dl class="space-y-2 text-sm text-text-2">
              <div class="flex items-baseline justify-between gap-4">
                <dt>1 USD at purchasing power parity</dt>
                <dd class="font-mono text-text-1">{symbol}{num(rate)} {currency}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt>1 {currency} at purchasing power parity</dt>
                <dd class="font-mono text-text-1">${num(1 / rate, 4)} USD</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt>$1,000 in the United States buys, in {country},</dt>
                <dd class="font-mono text-text-1">{symbol}{num(1000 * rate, 0)}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt>{symbol}1,000 in {country} buys, in the United States,</dt>
                <dd class="font-mono text-text-1">${num(1000 / rate)}</dd>
              </div>
            </dl>
            <p class="mt-3 text-[13px] text-text-3">
              OECD household final consumption expenditure PPPs, {PPP_VINTAGE}.
            </p>
          </section>
        )
      }

      {
        euroArea && (
          <section class="rounded-2xl border border-line bg-bg-1 p-5 shadow-sm">
            <h2 class="mb-1 text-sm font-semibold text-text-1">
              Every euro-area PPP rate against the dollar
            </h2>
            <p class="mb-3 text-[13px] text-text-3">
              Euros per US dollar of purchasing power, OECD {PPP_VINTAGE}. The
              same euro buys about {num(euroHigh.rate / euroLow.rate, 1)}× as much
              in {euroLow.name} as in {euroHigh.name}.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-line text-left text-[13px] text-text-3">
                    <th class="py-2 pr-3 font-medium">Country</th>
                    <th class="py-2 pr-3 text-right font-medium">EUR per USD (PPP)</th>
                    <th class="py-2 text-right font-medium">$1,000 buys</th>
                  </tr>
                </thead>
                <tbody>
                  {euroCountries.map((c) => (
                    <tr class="border-b border-line/60">
                      <td class="py-1.5 pr-3 text-text-1">{c.name}</td>
                      <td class="py-1.5 pr-3 text-right font-mono text-text-2">{num(c.rate, 3)}</td>
                      <td class="py-1.5 text-right font-mono text-text-2">€{num(1000 * c.rate, 0)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <section class="space-y-3 text-sm leading-relaxed text-text-2">
        {context.map((p) => <p>{p}</p>)}
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold tracking-tight text-text-1">
          How the conversion works
        </h2>
        <div class="space-y-3 text-sm leading-relaxed text-text-2">
          <p class="rounded-xl border border-line bg-bg-2 px-4 py-3 font-mono text-[13px] text-text-1">
            amount in B = (amount in A ÷ PPP rate of A) × PPP rate of B
          </p>
          <p>
            A PPP rate is the units of local currency that buy what one US
            dollar buys in the United States, so the US rate is 1 by
            construction and any pair runs through it. Use the
            <a href="/resources/ppp-calculator" class="text-blue-600 hover:text-blue-500">
              {" "}full calculator{" "}
            </a>
            to convert an arbitrary amount across all {Object.keys(PPP_RATES).length} countries
            at once.
          </p>
        </div>
      </section>

      <section>
        <h2 class="mb-4 text-xl font-semibold tracking-tight text-text-1">
          Frequently asked questions
        </h2>
        <FaqAccordion faqs={faqs} />
      </section>

      <section>
        <h2 class="mb-3 text-xl font-semibold tracking-tight text-text-1">
          Other pairs
        </h2>
        <ul class="list-disc space-y-2 pl-5 text-sm text-text-2">
          {
            others.map((p) => (
              <li>
                <a href={`/resources/ppp-calculator/${p.slug}`} class="text-blue-600 hover:text-blue-500">
                  {p.title}
                </a>{" "}
                — {p.teaser}
              </li>
            ))
          }
          <li>
            <a href="/resources/salary-explorer" class="text-blue-600 hover:text-blue-500">
              Average Salary Explorer
            </a>{" "}
            — OECD average wages in nominal, real and PPP-converted terms.
          </li>
        </ul>
      </section>
    </section>
  </main>
</Layout>
