---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Lost in the void" description="This page doesn't exist.">
  <main class="mx-auto px-4 py-24 flex flex-col items-center gap-6">
    <p style="font-size: 15vw;" class="leading-none font-[850] tracking-tighter text-line select-none">404</p>
    <div class="text-center space-y-2">
      <h1 class="text-xl font-bold tracking-tight">You've ventured off the map</h1>
      <p class="text-sm text-soft">This page got lost somewhere between Madrid and the internet.</p>
    </div>
    <div class="flex gap-3 mt-2">
      <a href="/" class="px-[14px] py-[6px] text-[13.5px] font-semibold bg-ink text-paper rounded-full hover:bg-accent transition-colors">Take me home</a>
      <a href="/resources" class="px-[14px] py-[6px] text-[13.5px] font-semibold border-[1.5px] border-ink rounded-full hover:bg-ink hover:text-paper transition-colors">Browse resources</a>
    </div>
  </main>
</Layout>
