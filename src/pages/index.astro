---
import Image from "astro/components/Image.astro";
import profile from "../assets/pictures/profile.jpg";
import Layout from "../layouts/Layout.astro";
import { PROJECTS } from "../data/projects.js";
import { TOOLS } from "../data/tools.js";
import { COURSES } from "../data/courses.js";

const courseModules = import.meta.glob("./courses/*.md", { eager: true });
const courseFrontmatter = Object.fromEntries(
  Object.entries(courseModules).map(([path, mod]) => [
    path.replace("./courses/", "").replace(".md", ""),
    mod.frontmatter,
  ]),
);
const teachingTeaser = COURSES.slice(0, 3).map(({ slug, meta }) => ({
  url: `/courses/${slug}`,
  meta,
  ...courseFrontmatter[slug],
}));

const experience = [
  {
    role: "Expert in Data Science",
    org: "Banco de España",
    meta: ["Sep 2026", "Madrid"],
    current: true,
  },
  {
    role: "AI Engineering Lead",
    org: "A5 Labs",
    meta: ["Oct 2025 — Aug 2026", "California, remote"],
    previously: { role: "Senior LLM Engineer", dates: "Jan — Sep 2025" },
  },
  { role: "Lead Data Scientist", org: "Pascual", meta: ["2024 — 2025", "Madrid"] },
  { role: "Data Scientist", org: "toom Baumarkt", meta: ["2023 — 2024", "Cologne"] },
  { role: "Product Engineer", org: "Leica Geosystems", meta: ["2019 — 2023", "Heerbrugg"] },
  { role: "Software Engineer", org: "Airbus Defence & Space", meta: ["2018 — 2019", "Munich"] },
  { role: "Software Engineer", org: "GMV", meta: ["2017", "Tres Cantos"] },
  { role: "Developer, intern", org: "AEMet", meta: ["2016", "Madrid"] },
];

const education = [
  {
    role: "MA Economics",
    org: "U. de las Hespérides",
    meta: ["2023 — 2024"],
    note: "Thesis: Quantity Theory of Money Around the Globe · honors in six subjects",
  },
  {
    role: "MSc Signal Theory & Communications",
    org: "U. Politécnica de Madrid",
    meta: ["2017 — 2019"],
    note: "Thesis: coaxial-to-waveguide transitions and mode transducers · 10/10, distinction",
  },
  {
    role: "BSc Aerospace Engineering",
    org: "U. Politécnica de Madrid",
    meta: ["2012 — 2016"],
    note: "Air navigation systems · thesis: SIGMET/AIRMET decoding tool · 9.5/10",
  },
];

const writing = [
  {
    title: "Revisiting Inflation in the American Civil War",
    sub: "APEE 50th Meeting, Las Vegas",
    meta: "2026",
    url: "/publications",
  },
  {
    title: "Sistemas de pensiones comparados",
    sub: "Centro Ruth Richardson, Hespérides",
    meta: "Nov 2025",
    url: "/docs/hesperides/sistemas_pensiones_comparados.pdf",
  },
  {
    title: "Big Data: el arte de domar las mareas",
    sub: "Revista Emprendedores",
    meta: "Sep 2025",
    url: "https://emprendedores.es/formacion/big-data-el-arte-de-domar-las-mareas-de-informacion/",
  },
  {
    title: "Quantity Theory of Money Around the Globe",
    sub: "MA thesis · Universidad de las Hespérides",
    meta: "2024",
    url: "/docs/meco-tfm.pdf",
  },
];
---

<Layout
  title="Miguel González Calvo — Data Scientist & AI Engineer"
  description="Miguel González Calvo, Expert in Data Science at Banco de España. Previously AI engineering at A5 Labs. Teaches economics, Python and blockchain; builds GNSS Calculator and Próxima Parada."
>
  <main class="page">
    <header class="section reveal" style="--i:0">
      <div class="hero__top">
        <Image
          class="hero__avatar"
          src={profile}
          alt="Miguel González Calvo"
          width={88}
          height={88}
          densities={[2]}
          loading="eager"
          fetchpriority="high"
        />
        <div>
          <h1 class="hero__name">Miguel González Calvo</h1>
          <p class="hero__where"><svg class="icon" aria-hidden="true"><use href="#i-pin" /></svg> Madrid, Spain</p>
        </div>
      </div>
      <p class="hero__bio">
        I'm a data scientist and AI engineer. I work at <a
          class="link link--ext"
          href="https://www.bde.es/"
          target="_blank"
          rel="noopener noreferrer">Banco de España<svg class="icon" aria-hidden="true"><use href="#i-arrow-out" /></svg></a
        >, Spain's central bank, as an Expert in Data Science.
      </p>
      <p class="hero__bio">
        Before that I led AI engineering at A5 Labs, building systems around language models,
        after eight years across aerospace, geodesy and retail data — Airbus, Leica, toom,
        Pascual. I also teach <a class="link" href="/courses/economics-i">economics</a>,
        <a class="link" href="/courses/python-for-finance">Python</a> and
        <a class="link" href="/courses/blockchain">blockchain</a> at three universities, and keep
        building things on the side — a GNSS calculator, a Renfe train app, and small tools on
        live OECD data.
      </p>
    </header>

    <section class="section reveal" id="projects" style="--i:1">
      <h2 class="section__title"><svg class="icon" aria-hidden="true"><use href="#i-box" /></svg> Projects</h2>
      <div class="rowlist">
        {
          PROJECTS.map((p) => (
            <a class="rowlink" href={p.url}>
              <span class="rowlink__icon">
                <svg class="icon" aria-hidden="true"><use href={`#${p.icon}`} /></svg>
              </span>
              <span class="rowlink__text">
                <span class="rowlink__name">
                  {p.name} <span class="tag">{p.platform}</span>
                </span>
                <span class="rowlink__desc">{p.summary}</span>
              </span>
              <svg class="icon rowlink__go" aria-hidden="true"><use href="#i-arrow-right" /></svg>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section reveal" id="tools" style="--i:2">
      <h2 class="section__title"><svg class="icon" aria-hidden="true"><use href="#i-terminal" /></svg> Tools</h2>
      <div class="rowlist">
        {
          TOOLS.map((t) => (
            <a class="rowlink" href={t.url}>
              <span class="rowlink__icon">
                <svg class="icon" aria-hidden="true"><use href={`#${t.icon}`} /></svg>
              </span>
              <span class="rowlink__text">
                <span class="rowlink__name">{t.name}</span>
                <span class="rowlink__desc">{t.desc}</span>
              </span>
              <svg class="icon rowlink__go" aria-hidden="true"><use href="#i-arrow-right" /></svg>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section reveal" style="--i:3">
      <h2 class="section__title"><svg class="icon" aria-hidden="true"><use href="#i-briefcase" /></svg> Experience</h2>
      <div class="tl">
        {
          experience.map((e, i) => (
            <div class:list={["tl__row", e.current && "tl__row--current"]}>
              <div class="tl__rail">
                <span class="tl__dot" />
                {i < experience.length - 1 && <span class="tl__line" />}
              </div>
              <div class="tl__body">
                <p>
                  <span class="tl__role">{e.role}</span> <span class="tl__org">· {e.org}</span>
                </p>
                <p class="tl__meta">
                  {e.current && <span class="badge-now">Now</span>}
                  {e.meta.map((m, j) => (
                    <>
                      {j > 0 && <span class="sep" />}
                      <span>{m}</span>
                    </>
                  ))}
                </p>
                {e.previously && (
                  <p class="tl__prev">
                    <span>
                      Previously <b>{e.previously.role}</b>
                    </span>
                    <span class="sep" />
                    <span>{e.previously.dates}</span>
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section reveal" style="--i:4">
      <h2 class="section__title"><svg class="icon" aria-hidden="true"><use href="#i-cap" /></svg> Teaching</h2>
      <div class="rowlist">
        {
          teachingTeaser.map((t) => (
            <a class="row" href={t.url}>
              <span class="row__main">
                <span class="row__title">{t.title}</span>
                <span class="row__sub">{t.university}</span>
              </span>
              <span class="row__meta">{t.meta}</span>
            </a>
          ))
        }
      </div>
      <p style="margin-top:0.75rem">
        <a class="link" href="/courses">All courses →</a>
      </p>
    </section>

    <section class="section reveal" style="--i:5">
      <h2 class="section__title"><svg class="icon" aria-hidden="true"><use href="#i-book" /></svg> Education</h2>
      <div class="tl">
        {
          education.map((e, i) => (
            <div class="tl__row">
              <div class="tl__rail">
                <span class="tl__dot" />
                {i < education.length - 1 && <span class="tl__line" />}
              </div>
              <div class="tl__body">
                <p>
                  <span class="tl__role">{e.role}</span> <span class="tl__org">· {e.org}</span>
                </p>
                <p class="tl__meta">
                  {e.meta.map((m) => (
                    <span>{m}</span>
                  ))}
                </p>
                <p class="tl__note">{e.note}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section reveal" id="writing" style="--i:6">
      <h2 class="section__title"><svg class="icon" aria-hidden="true"><use href="#i-doc" /></svg> Writing</h2>
      <div class="rowlist">
        {
          writing.map((w) => (
            <a class="row" href={w.url}>
              <span class="row__main">
                <span class="row__title">{w.title}</span>
                <span class="row__sub">{w.sub}</span>
              </span>
              <span class="row__meta">{w.meta}</span>
            </a>
          ))
        }
      </div>
      <p style="margin-top:0.75rem">
        <a class="link" href="/publications">All publications and talks →</a>
      </p>
    </section>
  </main>
</Layout>

<style>
  .hero__top { display: flex; align-items: center; gap: 0.875rem; margin-bottom: 1.25rem; }
  .hero__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-line);
  }
  .hero__name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-1);
    line-height: 1.25;
    letter-spacing: -0.005em;
  }
  .hero__where {
    font-size: 0.875rem;
    color: var(--color-text-3);
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }
  .hero__where :global(.icon) { font-size: 13px; }
  .hero__bio {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-2);
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .hero__bio:last-child { margin-bottom: 0; }

  .tl { display: flex; flex-direction: column; }
  .tl__row { display: flex; gap: 0.875rem; }
  .tl__rail { display: flex; flex-direction: column; align-items: center; width: 12px; flex-shrink: 0; }
  .tl__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-line-strong);
    margin-top: 7px;
    flex-shrink: 0;
  }
  .tl__row--current .tl__dot {
    background: var(--color-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-blue) 12%, transparent);
  }
  .tl__line {
    width: 1px;
    flex: 1;
    background: var(--color-line-strong);
    opacity: 0.7;
    margin-top: 4px;
  }
  .tl__body { padding-bottom: 1.5rem; flex: 1; min-width: 0; }
  .tl__row:last-child .tl__body { padding-bottom: 0; }
  .tl__role {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-1);
    letter-spacing: -0.01em;
  }
  .tl__org { font-size: 0.9375rem; font-weight: 400; color: var(--color-text-2); }
  .tl__meta,
  .tl__prev,
  .tl__note {
    font-size: 0.8125rem;
    color: var(--color-text-3);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .tl__meta { margin-top: 0.15rem; }
  /* An earlier title at the same employer — subordinate to the role above it. */
  .tl__prev { margin-top: 0.3rem; }
  .tl__prev b { font-weight: 500; color: var(--color-text-2); }
  /* Thesis / specialisation line under a degree. */
  .tl__note { margin-top: 0.3rem; display: block; line-height: 1.5; }
  .sep {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--color-text-3);
    opacity: 0.6;
  }
  .badge-now {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-blue);
    background: color-mix(in srgb, var(--color-blue) 10%, transparent);
    border-radius: 100px;
    padding: 0.1rem 0.5rem;
    letter-spacing: 0.01em;
  }

  .row__main { min-width: 0; }
</style>
