---
import { EMPLOYER, NOINDEX_PATHS } from "../data/site.js";

const { title, description, lang = "en", article = false, university } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og-image.jpg', Astro.site).href;

// Brand suffix, but only when it survives SERP truncation (~60 chars). On a
// page whose own title is already long and keyword-led — the QR generators,
// say — appending it just pushes the useful half out of the snippet and risks
// Google rewriting the title altogether, so those keep their own title.
const siteName = "Miguel González Calvo";
const SUFFIX = ` · ${siteName}`;
const TITLE_BUDGET = 60;
const fullTitle =
  title.includes(siteName) || title.length + SUFFIX.length > TITLE_BUDGET
    ? title
    : title + SUFFIX;

const noindex = NOINDEX_PATHS.includes(canonicalURL.pathname.replace(/\/$/, ""));

const articleLd = article ? (university ? {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": title,
  "description": description,
  "url": canonicalURL.href,
  "inLanguage": lang,
  "provider": {
    "@type": "EducationalOrganization",
    "name": university,
  },
  "instructor": {
    "@type": "Person",
    "name": "Miguel González Calvo",
    "url": Astro.site,
  },
} : {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": canonicalURL.href,
  "inLanguage": lang,
  "author": {
    "@type": "Person",
    "name": "Miguel González Calvo",
    "url": Astro.site,
  },
  "publisher": {
    "@type": "Person",
    "name": "Miguel González Calvo",
  },
  "image": socialImage,
}) : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Miguel González Calvo",
  "alternateName": "Miguel González",
  "givenName": "Miguel",
  "familyName": "González Calvo",
  "jobTitle": "Expert in Data Science",
  "url": Astro.site,
  "sameAs": [
    "https://linkedin.com/in/mgcalvo/",
    "https://github.com/MiguelPuntoEs",
    "https://www.youtube.com/@MiguelPuntoEs"
  ],
  "worksFor": {
    "@type": "Organization",
    "name": EMPLOYER
  },
  "alumniOf": [
    {
      "@type": "EducationalOrganization",
      "name": "Universidad Politécnica de Madrid"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Universidad de las Hespérides"
    }
  ],
  "knowsAbout": [
    "Machine Learning",
    "Large Language Models",
    "Data Science",
    "Economics",
    "Python",
    "Blockchain"
  ]
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />
<meta http-equiv="onion-location" content="http://miguel3wuxsv5wb63n7522pvk7tpwc3lvsvbdzai32bvvca2ac5olbqd.onion/" />
{noindex && <meta name="robots" content="noindex, follow" />}

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Miguel González Calvo" />

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
<meta property="og:site_name" content="Miguel González Calvo" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
