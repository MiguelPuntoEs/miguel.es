---
export interface Props {
  logo: any;
  degree: string;
  university: string;
  dateRange: string;
  grade?: string;
  specialization?: string;
  thesis?: { title: string; grade: string };
  honors?: string[];
}
const {
  logo: Logo,
  degree,
  university,
  dateRange,
  grade = "",
  specialization = "",
  thesis,
  honors = [],
} = Astro.props;
---

<article class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-2 py-7 border-t border-hair">
  <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-hair bg-panel/60">
    <Logo height={28} width={28} class="max-h-7 max-w-7" />
  </div>

  <div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
      <h3 class="font-display text-xl leading-tight">{degree}</h3>
      <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-soft"
        >{dateRange}</span
      >
    </div>
    <p class="mt-1 text-sm text-ink-soft">{university}</p>

    <div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-0.5 font-mono text-xs text-ink-soft">
      {grade && <span>Grade {grade}</span>}
      {specialization && <span>{specialization}</span>}
    </div>

    {
      thesis && (
        <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-soft">
          <span class="font-medium text-ink">Thesis.</span> {thesis.title}{" "}
          <span class="text-ink-soft">— {thesis.grade}</span>
        </p>
      )
    }

    {
      honors.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {honors.map((h) => (
            <li class="rounded-full border border-hair px-2.5 py-0.5 text-xs text-ink-soft">
              {h}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
