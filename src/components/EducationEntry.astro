---
export interface Props {
  degree: string;
  university: string;
  dateRange: string;
  note?: string;
}

const { degree, university, dateRange, note } = Astro.props;
---

<div class="flex gap-[18px] py-[9px] items-baseline">
  <span class="text-[13px] text-soft min-w-[76px] shrink-0 tabular-nums">{dateRange}</span>
  <span>
    <span class="font-bold">{degree}</span>
    <span class="text-soft text-sm">· {university}</span>
    {note && <span class="block text-[13px] text-soft">{note}</span>}
  </span>
</div>
