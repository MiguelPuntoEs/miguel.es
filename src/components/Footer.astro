---
import { DISCLAIMER } from "../data/site.js";

const year = new Date().getFullYear();
const onion = "miguel3wuxsv5wb63n7522pvk7tpwc3lvsvbdzai32bvvca2ac5olbqd.onion";
---

<footer class="footer">
  <div class="footer__links">
    <a href="https://linkedin.com/in/mgcalvo/" target="_blank" rel="noopener noreferrer">
      <svg class="icon"><use href="#i-linkedin" /></svg> LinkedIn
    </a>
    <a href="https://github.com/MiguelPuntoEs" target="_blank" rel="noopener noreferrer">
      <svg class="icon"><use href="#i-github" /></svg> GitHub
    </a>
    <a href="https://www.youtube.com/@MiguelPuntoEs" target="_blank" rel="noopener noreferrer">
      <svg class="icon"><use href="#i-play" /></svg> YouTube
    </a>
  </div>

  <div class="copyrow">
    <span class="copyrow__label">Also on Tor</span>
    <button class="onion" id="onion-copy" type="button" data-onion={onion} aria-label="Copy onion address">
      <span class="onion__addr">{onion}</span>
      <svg class="icon icon--copy"><use href="#i-copy" /></svg>
      <svg class="icon icon--check"><use href="#i-check" /></svg>
    </button>
  </div>

  <p class="footer__fine">
    Messages sent through this site aren't monitored — LinkedIn is the reliable inbox.
  </p>

  <p class="disclaimer">{DISCLAIMER}</p>

  <p class="footer__fine">© {year} Miguel González Calvo</p>
</footer>

<style>
  .footer {
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 3rem;
    border-top: 1px solid var(--color-line);
  }
  .footer__links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-bottom: 1.25rem; }
  .footer__links a {
    font-size: 0.875rem;
    color: var(--color-text-3);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s;
  }
  .footer__links a:hover { color: var(--color-blue); }
  .footer__links :global(.icon) { font-size: 15px; }

  .copyrow { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .copyrow__label { font-size: 0.8125rem; color: var(--color-text-3); }
  .onion {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--color-text-3);
    background: var(--color-bg-2);
    border: 1px solid var(--color-line);
    border-radius: 100px;
    padding: 0.3rem 0.7rem;
    max-width: 100%;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .onion:hover { color: var(--color-text-1); border-color: var(--color-line-strong); }
  .onion__addr { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .onion :global(.icon) { font-size: 13px; }
  .onion :global(.icon--check) { display: none; color: var(--color-blue); }
  .onion:global(.copied) { color: var(--color-blue); border-color: var(--color-blue); }
  .onion:global(.copied) :global(.icon--copy) { display: none; }
  .onion:global(.copied) :global(.icon--check) { display: block; }

  .footer__fine { margin-top: 1.25rem; font-size: 0.75rem; color: var(--color-text-3); }

  /* Formal notice: set apart from the practical footer notes above it. */
  .disclaimer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-text-3);
    max-width: 52ch;
  }
</style>

<script>
  const btn = document.getElementById("onion-copy");
  const addr = btn?.dataset.onion ?? "";
  let resetTimer: ReturnType<typeof setTimeout>;

  btn?.addEventListener("click", async () => {
    const url = `http://${addr}/`;
    try {
      await navigator.clipboard.writeText(url);
      btn.classList.add("copied");
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => btn.classList.remove("copied"), 1800);
    } catch {
      window.open(url, "_blank", "noopener");
    }
  });
</script>
