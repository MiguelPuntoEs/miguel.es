---
export interface Props {
  title: string;
  description?: string;
  url?: string;
}

const { title, description, url } = Astro.props;
const Tag = url ? "a" : "div";
---

<Tag class="row" href={url}>
  <span class="row__main">
    <span class="row__title">{title}</span>
    {description && <span class="row__sub">{description}</span>}
  </span>
</Tag>

<style>
  .row__main { min-width: 0; }
</style>
