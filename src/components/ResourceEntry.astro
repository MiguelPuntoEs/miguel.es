---
export interface Props {
  title: string;
  description?: string;
  url?: string;
}

const { title, description, url } = Astro.props;
---

<div class="flex flex-col items-start gap-1">
  {
    url ? (
      <a
        href={url}
        class="font-bold text-sm border-b-2 border-accent/35 hover:text-accent hover:border-accent"
      >
        {title}
      </a>
    ) : (
      <h3 class="font-bold text-sm">{title}</h3>
    )
  }
  {
    description && (
      <p class="text-[13px] text-soft leading-relaxed">{description}</p>
    )
  }
</div>
