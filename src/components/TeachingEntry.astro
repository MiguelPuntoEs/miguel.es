---
export interface Props {
  logo: any;
  courseName: string;
  university: string;
  dateRange: string;
  url?: string;
}
const { logo: Logo, courseName, university, dateRange, url } = Astro.props;
const Wrapper = url ? "a" : "div";
---

<Wrapper
  {...url ? { href: url } : {}}
  class:list={[
    "group flex h-full flex-col rounded-xl border border-hair bg-panel/40 p-5 transition-all",
    url && "hover:-translate-y-0.5 hover:border-amber/60 hover:bg-panel/70",
  ]}
>
  <div class="mb-4 flex items-center justify-between">
    <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-hair bg-paper">
      <Logo height={22} width={22} class="max-h-5 max-w-5" />
    </div>
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-soft"
      >{dateRange}</span
    >
  </div>
  <h3 class="font-display text-lg leading-snug">
    {courseName}
    {url && <span class="text-amber transition-transform group-hover:translate-x-0.5 inline-block">→</span>}
  </h3>
  <p class="mt-1 text-sm text-ink-soft">{university}</p>
</Wrapper>
