---
export interface Props {
  courseName: string;
  university: string;
  dateRange: string;
  url?: string;
}

const { courseName, university, dateRange, url } = Astro.props;
---

<div class="flex gap-[18px] py-[9px] items-baseline">
  <span class="text-[13px] text-soft min-w-[76px] shrink-0 tabular-nums">{dateRange}</span>
  <span>
    {
      url ? (
        <a
          href={url}
          class="font-bold border-b-2 border-accent/35 hover:text-accent hover:border-accent"
        >
          {courseName}
        </a>
      ) : (
        <span class="font-bold">{courseName}</span>
      )
    }
    <span class="text-soft text-sm">· {university}</span>
  </span>
</div>
