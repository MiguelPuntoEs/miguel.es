---
// "Home" is the wordmark, following the usual convention, so it isn't listed.
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/publications", label: "Writing" },
  { href: "/resources", label: "Resources" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<nav class="nav" aria-label="Main">
  <div class="nav__inner">
    <a class="wordmark" href="/" aria-current={path === "/" ? "page" : undefined}>
      <b>Miguel</b><span class="wordmark__rest"> González Calvo</span>
    </a>
    <div class="nav__links">
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </div>
    <button class="nav__toggle" id="theme-toggle" type="button" aria-label="Switch theme">
      <svg class="icon icon--sun"><use href="#i-sun" /></svg>
      <svg class="icon icon--moon"><use href="#i-moon" /></svg>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg-1) 82%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s;
  }
  .nav:global(.scrolled) { border-bottom-color: var(--color-line); }
  .nav__inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  /* The wordmark doubles as the home link, so it carries slightly more weight
     than the nav items without leaving the type scale. */
  .wordmark {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--color-text-3);
    white-space: nowrap;
    margin-right: auto;
    transition: color 0.2s;
  }
  .wordmark b { font-weight: 600; color: var(--color-text-1); }
  .wordmark:hover { color: var(--color-text-1); }

  .nav__links { display: flex; gap: 1.25rem; font-size: 0.875rem; font-weight: 500; }
  .nav__links a { color: var(--color-text-3); transition: color 0.2s; }
  .nav__links a:hover,
  .nav__links a[aria-current] { color: var(--color-text-1); }
  .nav__toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--color-text-3);
    font-size: 17px;
    cursor: pointer;
    transition: color 0.2s, background-color 0.25s;
  }
  .nav__toggle:hover { color: var(--color-text-1); background: var(--color-bg-2); }
  .nav__toggle :global(.icon--moon) { display: none; }
  :global([data-theme="dark"]) .nav__toggle :global(.icon--sun) { display: none; }
  :global([data-theme="dark"]) .nav__toggle :global(.icon--moon) { display: block; }

  /* Below this the full name and three links no longer fit on one line, so the
     wordmark drops to the first name rather than letting the bar wrap. */
  @media (max-width: 560px) {
    .wordmark__rest { display: none; }
  }
  @media (max-width: 400px) {
    .nav__inner { padding-inline: 1rem; gap: 0.75rem; }
    .nav__links { gap: 0.9rem; font-size: 0.8125rem; }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");

  const syncLabel = () => {
    btn?.setAttribute(
      "aria-label",
      root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
    );
  };
  syncLabel();

  btn?.addEventListener("click", () => {
    root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
    try {
      localStorage.setItem("theme", root.dataset.theme);
    } catch {
      /* private mode — the choice just won't persist */
    }
    syncLabel();
  });

  const nav = document.querySelector(".nav");
  const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 8);
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });
</script>
