---
export interface Props {
  jobTitle: string;
  companyName: string;
  dateRange: string;
  location: string;
}

const { jobTitle, companyName, dateRange, location } = Astro.props;
---

<div class="flex gap-[18px] py-[9px] items-baseline">
  <span class="text-[13px] text-soft min-w-[76px] shrink-0 tabular-nums">{dateRange}</span>
  <span>
    <span class="font-bold">{jobTitle}</span>
    <span class="text-soft text-sm">· {companyName}, {location}</span>
  </span>
</div>
