---
import Sparkline from "./Sparkline.astro";

export interface Role {
  jobTitle: string;
  dateRange: string;
}
export interface Props {
  logo: any;
  companyName: string;
  location: string;
  logoClass?: string;
  jobTitle?: string;
  dateRange?: string;
  roles?: Role[];
  summary?: string;
  metric?: { value: string; label: string; points: number[] };
}

const {
  logo: Logo,
  companyName,
  location,
  logoClass = "",
  jobTitle,
  dateRange,
  roles,
  summary,
  metric,
} = Astro.props;

const roleList: Role[] =
  roles && roles.length > 0
    ? roles
    : [{ jobTitle: jobTitle ?? "", dateRange: dateRange ?? "" }];
---

<article class="group grid grid-cols-[auto_1fr] gap-x-5 gap-y-3 rounded-2xl border-t border-hair px-3 py-7 transition-colors hover:bg-panel sm:px-5">
  <div
    class:list={[
      "flex h-12 w-12 items-center justify-center rounded-xl border border-hair bg-panel/60",
      logoClass,
    ]}
  >
    <Logo height={28} width={28} class="max-h-7 max-w-7" />
  </div>

  <div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
      <h3 class="font-display text-xl leading-tight">{companyName}</h3>
      <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-soft"
        >{location}</span
      >
    </div>

    <ul class="mt-3 space-y-1.5">
      {
        roleList.map((role, i) => (
          <li class="flex flex-wrap items-baseline gap-x-3">
            <span
              class:list={[
                "h-1.5 w-1.5 shrink-0 translate-y-[-1px] rounded-full",
                i === 0 ? "bg-amber" : "bg-hair",
              ]}
            />
            <span class="text-sm font-medium">{role.jobTitle}</span>
            <span class="font-mono text-xs text-ink-soft">{role.dateRange}</span>
          </li>
        ))
      }
    </ul>

    {summary && <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-soft">{summary}</p>}

    {
      metric && (
        <div class="mt-3 inline-flex items-center gap-3 rounded-lg bg-amber-soft/50 px-3 py-1.5">
          <Sparkline points={metric.points} color="var(--color-pine)" />
          <span class="font-display text-lg leading-none text-pine">{metric.value}</span>
          <span class="font-mono text-[0.7rem] uppercase tracking-[0.08em] text-ink-soft">
            {metric.label}
          </span>
        </div>
      )
    }
  </div>
</article>
