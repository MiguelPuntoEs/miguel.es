---
import "../styles/global.css";
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
const { title, description, latex, lang, university } = frontmatter;
---

<Layout {title} {description} {lang} article {university}>
  {latex && <link slot="head" href="/vendor/katex/katex.min.css" rel="stylesheet" />}
  <main class="page">
    <article class="doc reveal" style="--i:0">
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</Layout>

<style is:global>
  .doc {
    font-size: 0.9375rem;
    color: var(--color-text-2);
    line-height: 1.7;
  }
  .doc h1 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-1);
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin-bottom: 1.5rem;
  }
  .doc h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-1);
    letter-spacing: -0.01em;
    margin: 2.25rem 0 0.75rem;
  }
  .doc h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-1);
    margin: 1.75rem 0 0.5rem;
  }
  .doc h4 { font-size: 0.9375rem; font-weight: 600; color: var(--color-text-2); margin: 1.25rem 0 0.4rem; }
  .doc p { margin-bottom: 0.875rem; }
  .doc a {
    color: var(--color-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
    transition: color 0.2s;
  }
  .doc a:hover { color: var(--color-blue-hover); }
  .doc ul, .doc ol { margin: 0 0 0.875rem; padding-left: 1.25rem; }
  .doc ul { list-style: disc; }
  .doc ol { list-style: decimal; }
  .doc li { margin-bottom: 0.35rem; }
  .doc li::marker { color: var(--color-text-3); }
  .doc strong { font-weight: 600; color: var(--color-text-1); }
  .doc hr { border: 0; border-top: 1px solid var(--color-line); margin: 2rem 0; }
  .doc blockquote {
    border-left: 3px solid var(--color-line-strong);
    padding-left: 1rem;
    color: var(--color-text-3);
    margin: 0 0 0.875rem;
  }
  .doc code {
    background: var(--color-bg-2);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    font-size: 0.8125rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  .doc pre {
    background: var(--color-bg-2);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .doc pre code { background: none; padding: 0; font-size: 0.8125rem; }
  .doc img { border-radius: 10px; margin: 1.5rem 0; }
  .doc table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; font-size: 0.875rem; }
  .doc th, .doc td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--color-line); }
  .doc th { color: var(--color-text-3); font-weight: 500; }

  /* KaTeX renders inline SVG/HTML that inherits colour; keep it legible in dark. */
  .doc .katex { color: var(--color-text-1); }
  .doc .katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.25rem 0; }
</style>
