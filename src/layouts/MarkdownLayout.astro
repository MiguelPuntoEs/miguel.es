---
import "../styles/global.css";
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
const { title, description, latex, lang, university } = frontmatter;
---

<Layout {title} {description} {lang} article {university}>
  {
    latex && (
      <link
        slot="head"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
        rel="stylesheet"
      />
    )
  }
  <main class="mx-auto max-w-3xl px-5 sm:px-8 pt-12 sm:pt-16">
    <article
      class="prose prose-sm max-w-none prose-headings:font-display prose-headings:font-medium prose-h1:text-4xl prose-h1:leading-tight prose-h2:mt-10 prose-h2:text-2xl prose-h3:text-xl prose-p:text-ink-soft prose-li:text-ink-soft prose-strong:text-ink prose-a:text-amber prose-a:no-underline hover:prose-a:underline prose-a:underline-offset-4 prose-code:rounded prose-code:bg-panel prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-ink prose-code:text-[0.85em] prose-blockquote:border-amber prose-hr:border-hair"
    >
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-amber not-prose mb-3">
        {university ?? "Miguel González Calvo"}
      </p>
      <h1 class="!mt-0">{title}</h1>
      <slot />
    </article>
  </main>
</Layout>
