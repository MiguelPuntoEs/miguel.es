---
import "../styles/global.css";
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
const { title, description, latex, lang, university } = frontmatter;
---

<Layout {title} {description} {lang} article {university}>
  {
    latex && (
      <link
        slot="head"
        href="/vendor/katex/katex.min.css"
        rel="stylesheet"
      />
    )
  }
  <main
    class="prose prose-sm prose-stone max-w-3xl mx-auto px-4
      prose-p:mb-1 prose-ul:my-1 prose-ol:my-1
      prose-headings:tracking-tight prose-headings:font-bold
      prose-h1:text-[30px] prose-h1:font-[850] prose-h1:tracking-[-0.03em] prose-h1:text-ink
      prose-h2:text-[13px] prose-h2:font-extrabold prose-h2:text-accent prose-h2:border-b-2 prose-h2:border-ink prose-h2:pb-[6px]
      prose-a:text-ink prose-a:decoration-accent prose-a:decoration-[1.5px] prose-a:underline-offset-[3px] hover:prose-a:text-accent"
  >
    <article class="mt-8">
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</Layout>
