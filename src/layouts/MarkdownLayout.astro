---
import "../styles/global.css";
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
const { title, description, latex, lang, university } = frontmatter;
---

<Layout {title} {description} {lang} article {university}>
  {latex && <link slot="head" href="/vendor/katex/katex.min.css" rel="stylesheet" />}
  <main class="page">
    <article class="doc reveal" style="--i:0">
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</Layout>
