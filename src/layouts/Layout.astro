---
import MainHead from "../components/MainHead.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";
const { title, description, lang = "en", article = false, university, bare = false } = Astro.props;
---

<html lang={lang} class="scroll-smooth">
  <head>
    <MainHead {title} {description} {lang} {article} {university} />
    <slot name="head" />
  </head>

  <body>
    {!bare && <Navbar />}
    <slot />
    {!bare && <Footer />}
  </body>
</html>
